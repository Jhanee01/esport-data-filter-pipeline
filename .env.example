# Copy to .env and fill in what you need. Never commit the real .env.

# Telegram bot token from @BotFather. Without it signals are only recorded locally.
TELEGRAM_TOKEN=

# Token for the phone remote page. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
REMOTE_TOKEN=
REMOTE_PORT=8765

# Odds source as module:Class. The demo source invents prices; point this at your own
# private scraper package, e.g. my_private_plugins.mybook:MyBookSource
ODDS_SOURCE=signal_pipeline.odds.demo:DemoOddsSource
POLL_SECONDS=30

# Where data (SQLite, routing, Strategy Lab rules) and Python strategy plugins live.
# PIPELINE_DATA_DIR=./data
# PIPELINE_STRATEGIES_DIR=./strategies
